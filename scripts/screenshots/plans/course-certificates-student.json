{
  "_note": "Student side: profile tab, share dialog (with Download Open Badge) and the public verification page. Credential ID below belongs to the demo certificate.",
  "outDir": "docs/public/images/course-and-learning/course-certificates",
  "viewport": {
    "width": 1600,
    "height": 1300
  },
  "steps": [
    {
      "portal": "/portal/u/tajul"
    },
    {
      "click": {
        "text": "Certificates"
      }
    },
    {
      "wait": 2000
    },
    {
      "eval": "document.activeElement && document.activeElement.blur()"
    },
    {
      "shot": {
        "name": "student-profile-certificates",
        "clip": "viewport"
      }
    },
    {
      "click": {
        "text": "View and share"
      }
    },
    {
      "wait": 2500
    },
    {
      "shot": {
        "name": "student-certificate-share-dialog",
        "clip": "viewport",
        "arrows": [
          {
            "target": {
              "text": "Download Open Badge"
            },
            "from": "right",
            "len": 130
          }
        ]
      }
    },
    {
      "portal": "/portal/certificates/FC-QS4L-5LSL-9DCS",
      "waitForApp": false
    },
    {
      "wait": 2500
    },
    {
      "shot": {
        "name": "verification-page-valid",
        "clip": "viewport"
      }
    }
  ]
}