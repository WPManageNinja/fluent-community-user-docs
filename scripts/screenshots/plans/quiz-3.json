{
  "_note": "Run 2 of the quiz demo: Q1 already exists. Adds image options (not saved), rating scale and instructor-graded written questions, sets limits, saves.",
  "outDir": "docs/public/images/course-and-learning/using-the-quiz-module",
  "viewport": {
    "width": 1600,
    "height": 1100
  },
  "steps": [
    {
      "portal": "/portal/admin/manage-courses/edit/6"
    },
    {
      "click": {
        "text": "Lessons"
      }
    },
    {
      "wait": 2000
    },
    {
      "click": {
        "text": "Writing Basics Check"
      }
    },
    {
      "wait": 3000
    },
    {
      "wait": 900
    },
    {
      "wait": 1500
    },
    {
      "eval": "[...document.querySelectorAll('button')].find(b=>b.textContent.trim()==='+ Add Question').click()"
    },
    {
      "wait": 900
    },
    {
      "wait": 1500
    },
    {
      "click": {
        "text": "Image options"
      }
    },
    {
      "wait": 900
    },
    {
      "shot": {
        "name": "quiz-image-options",
        "clip": {
          "element": ".el-dialog:visible",
          "pad": 0
        },
        "arrows": [
          {
            "target": {
              "text": "Image options"
            },
            "from": "right",
            "len": 130
          }
        ]
      }
    },
    {
      "press": "Escape"
    },
    {
      "click": {
        "text": "Discard"
      }
    },
    {
      "wait": 1200
    },
    {
      "wait": 1200
    },
    {
      "eval": "[...document.querySelectorAll('button')].find(b=>b.textContent.trim()==='+ Add Question').click()"
    },
    {
      "wait": 900
    },
    {
      "wait": 1500
    },
    {
      "click": ".el-dialog:visible .el-select"
    },
    {
      "wait": 600
    },
    {
      "click": {
        "text": "Rating Scale"
      }
    },
    {
      "wait": 800
    },
    {
      "click": ".el-dialog:visible .ProseMirror"
    },
    {
      "type": "How would you rate this lesson?"
    },
    {
      "fill": {
        "selector": ".el-dialog:visible input[placeholder^='Label for the lowest']",
        "value": "Not helpful"
      }
    },
    {
      "fill": {
        "selector": ".el-dialog:visible input[placeholder^='Label for the highest']",
        "value": "Very helpful"
      }
    },
    {
      "shot": {
        "name": "quiz-rating-scale-question",
        "clip": {
          "element": ".el-dialog:visible",
          "pad": 0
        }
      }
    },
    {
      "click": ".el-dialog:visible .fcom_primary_button"
    },
    {
      "wait": 3000
    },
    {
      "eval": "[...document.querySelectorAll('button')].find(b=>b.textContent.trim()==='+ Add Question').click()"
    },
    {
      "wait": 900
    },
    {
      "wait": 1500
    },
    {
      "click": ".el-dialog:visible .el-select"
    },
    {
      "wait": 600
    },
    {
      "click": {
        "text": "Written Answer"
      }
    },
    {
      "wait": 800
    },
    {
      "click": ".el-dialog:visible .ProseMirror"
    },
    {
      "type": "In one sentence, why does your audience matter?"
    },
    {
      "click": {
        "text": "Graded by instructor"
      }
    },
    {
      "wait": 500
    },
    {
      "shot": {
        "name": "quiz-written-answer-grading",
        "clip": {
          "element": ".el-dialog:visible",
          "pad": 0
        },
        "arrows": [
          {
            "target": {
              "text": "Graded by instructor"
            },
            "from": "right",
            "len": 60
          }
        ]
      }
    },
    {
      "click": ".el-dialog:visible .fcom_primary_button"
    },
    {
      "wait": 3000
    },
    {
      "click": {
        "text": "Set a passing grade"
      }
    },
    {
      "click": {
        "text": "Limit attempts"
      }
    },
    {
      "click": {
        "text": "Set a time limit"
      }
    },
    {
      "wait": 500
    },
    {
      "click": {
        "role": "button",
        "name": "^save$"
      }
    },
    {
      "wait": 2500
    },
    {
      "shot": {
        "name": "quiz-editor-with-questions",
        "clip": "viewport"
      }
    }
  ]
}