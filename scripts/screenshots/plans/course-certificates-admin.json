{
  "outDir": "docs/public/images/course-and-learning/course-certificates",
  "viewport": { "width": 1600, "height": 1000 },
  "steps": [
    { "portal": "/portal/admin/settings" },
    { "click": { "text": "Certificates" } },
    { "wait": 1200 },
    { "click": { "text": "Course Certificates" } },
    { "wait": 1800 },
    { "eval": "document.activeElement && document.activeElement.blur()" },
    { "shot": { "name": "issued-certificates-list", "clip": "viewport", "crop": { "height": 620 } } },
    { "click": ".el-dropdown" },
    { "wait": 800 },
    { "shot": { "name": "issued-certificate-actions", "clip": "viewport", "crop": { "height": 760 } } },
    { "press": "Escape" },
    { "click": { "text": "Manual Certificates" } },
    { "wait": 1500 },
    { "click": ".el-dropdown" },
    { "wait": 800 },
    { "shot": { "name": "manual-certificate-actions", "clip": "viewport", "crop": { "height": 760 } } }
  ]
}
