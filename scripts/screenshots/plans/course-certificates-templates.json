{
  "_note": "Needs one unpublished template named 'Course Completion' (Classic Gold). Publishes it, then shoots the templates list.",
  "outDir": "docs/public/images/course-and-learning/course-certificates",
  "viewport": { "width": 1600, "height": 1000 },
  "steps": [
    { "portal": "/portal/admin/settings" },
    { "click": { "text": "Certificates" } },
    { "wait": 1500 },
    { "click": { "text": "New Template" } },
    { "wait": 800 },
    { "fill": { "selector": ".el-dialog input[type='text'], .el-dialog input:not([type])", "value": "Workshop Attendance" } },
    { "click": { "text": "Classic Gold" } },
    { "shot": { "name": "new-certificate-template", "clip": "viewport" } },
    { "click": { "text": "Cancel" } },
    { "wait": 600 },
    { "click": { "text": "Course Completion" } },
    { "wait": 4000 },
    { "click": { "role": "button", "name": "^publish$" } },
    { "wait": 1000 },
    { "shot": { "name": "certificate-publish-template", "clip": { "element": ".el-message-box", "pad": 60 },
                "arrows": [ { "target": { "selector": ".el-message-box button.el-button--primary" }, "from": "right", "len": 120 } ] } },
    { "click": { "selector": ".el-message-box button.el-button--primary" } },
    { "wait": 2500 },
    { "portal": "/portal/admin/settings" },
    { "click": { "text": "Certificates" } },
    { "wait": 2000 },
    { "shot": { "name": "certificate-templates-list", "clip": "viewport" } }
  ]
}
