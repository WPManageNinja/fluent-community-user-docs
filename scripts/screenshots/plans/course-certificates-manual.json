{
  "_note": "Issues two demo manual certificates for fictional people (example.com), with the email box unchecked.",
  "outDir": "docs/public/images/course-and-learning/course-certificates",
  "viewport": { "width": 1600, "height": 1500 },
  "steps": [
    { "portal": "/portal/admin/settings" },
    { "click": { "text": "Certificates" } },
    { "wait": 1200 },
    { "click": { "text": "Manual Certificates" } },
    { "wait": 1200 },
    { "click": { "role": "button", "name": "issue certificate" } },
    { "wait": 1200 },
    { "fillByLabel": { "label": "Full name", "value": "Maya Rahman" } },
    { "fillByLabel": { "label": "Email", "value": "maya.rahman@example.com" } },
    { "fillByLabel": { "label": "Certificate title", "value": "Certificate of Attendance" } },
    { "fillByLabel": { "label": "Course title", "value": "Community Building Workshop" } },
    { "wait": 800 },
    { "shot": { "name": "manual-certificate-dialog", "clip": { "element": ".el-dialog", "pad": 0 } } },
    { "click": { "text": "Email the certificate to the person" } },
    { "click": { "selector": ".el-dialog button", "hasText": "Issue certificate" } },
    { "wait": 2500 },
    { "click": { "role": "button", "name": "issue certificate" } },
    { "wait": 1200 },
    { "fillByLabel": { "label": "Full name", "value": "Daniel Okafor" } },
    { "fillByLabel": { "label": "Email", "value": "daniel.okafor@example.com" } },
    { "fillByLabel": { "label": "Certificate title", "value": "Guest Speaker Certificate" } },
    { "fillByLabel": { "label": "Course title", "value": "Community Building Workshop" } },
    { "click": { "text": "Email the certificate to the person" } },
    { "click": { "selector": ".el-dialog button", "hasText": "Issue certificate" } },
    { "wait": 2500 },
    { "eval": "document.activeElement && document.activeElement.blur()" },
    { "shot": { "name": "manual-certificates-list", "clip": "viewport", "crop": { "height": 760 } } }
  ]
}
