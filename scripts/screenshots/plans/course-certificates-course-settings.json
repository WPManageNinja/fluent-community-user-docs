{
  "_note": "Needs a published template and a course (id 6) that students already finished while certificates were still off.",
  "outDir": "docs/public/images/course-and-learning/course-certificates",
  "viewport": { "width": 1600, "height": 1000 },
  "steps": [
    { "portal": "/portal/admin/manage-courses/edit/6/settings" },
    { "click": { "text": "Certificate" } },
    { "wait": 1200 },
    { "click": ".el-switch" },
    { "wait": 1200 },
    { "shot": { "name": "course-certificate-tab", "clip": "viewport", "crop": { "height": 940 },
                "arrows": [ { "target": ".el-switch", "from": "left", "len": 110 } ] } },
    { "click": { "role": "button", "name": "^save changes$" } },
    { "wait": 3000 },
    { "shot": { "name": "course-certificate-backfill", "clip": "viewport", "crop": { "height": 1100 } } }
  ]
}
